# Copie para .env e ajuste.
# PostgreSQL local sem instalar nada (npm run db:local):
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# O PGlite atende uma conexão por vez:
PG_MAX=1
# Com Docker (docker compose up -d), troque pelas duas linhas abaixo:
# DATABASE_URL=postgres://caixa:caixa@127.0.0.1:5432/caixa
# PG_MAX=10

# Segredo que assina a sessão (pelo menos 32 caracteres). Gere um com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio-de-verdade
PORT=3000
# Banco na nuvem que exige SSL (Neon, Render...):
# PG_SSL=true
